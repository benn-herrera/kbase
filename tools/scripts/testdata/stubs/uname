#!/usr/bin/env bash
# Stands in for uname: reports the platform the case names.
set -uo pipefail
: "${STUB_UNAME_S:?STUB_UNAME_S is not set}"
: "${STUB_UNAME_M:?STUB_UNAME_M is not set}"

case "${1:-}" in
  -s) printf '%s\n' "${STUB_UNAME_S}" ;;
  -m) printf '%s\n' "${STUB_UNAME_M}" ;;
  *)
    printf 'stub uname: unexpected argument: %s\n' "${*}" >&2
    exit 2
    ;;
esac
