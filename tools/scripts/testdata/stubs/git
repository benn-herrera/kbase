#!/usr/bin/env bash
# Stands in for git, so no case touches the repository the script runs in.
# Answers only the three calls build-dist.sh makes, and records every call.
#   rev-parse -q --verify refs/tags/<v>   succeeds when STUB_GIT_TAG_EXISTS=1
#   status --porcelain --untracked-files=no   prints STUB_GIT_DIRTY, if set
#   tag <v>                                logs the tag with the number of gpg
#                                          calls made so far
set -uo pipefail
: "${STUB_STATE_DIR:?STUB_STATE_DIR is not set}"
state="${STUB_STATE_DIR}"

{ printf 'git'; printf ' %s' "$@"; printf '\n'; } >> "${state}/git.log"

case "${1:-}" in
  rev-parse)
    [[ "${2:-}" == "-q" && "${3:-}" == "--verify" && "${4:-}" == refs/tags/* ]] || {
      printf 'stub git: unexpected rev-parse: %s\n' "${*}" >&2
      exit 2
    }
    [[ "${STUB_GIT_TAG_EXISTS:-0}" == "1" ]]
    ;;
  status)
    [[ "${2:-}" == "--porcelain" && "${3:-}" == "--untracked-files=no" ]] || {
      printf 'stub git: unexpected status: %s\n' "${*}" >&2
      exit 2
    }
    if [[ -n "${STUB_GIT_DIRTY:-}" ]]; then
      printf '%s\n' "${STUB_GIT_DIRTY}"
    fi
    ;;
  tag)
    [[ "$#" -eq 2 ]] || {
      printf 'stub git: unexpected tag: %s\n' "${*}" >&2
      exit 2
    }
    printf 'tagged %s after %s gpg calls\n' "${2}" "$(wc -l < "${state}/gpg.log" | tr -d ' ')" >> "${state}/git.log"
    ;;
  *)
    printf 'stub git: unexpected invocation: %s\n' "${*}" >&2
    exit 2
    ;;
esac
