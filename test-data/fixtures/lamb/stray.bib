% A second bibliography beside the paper, answering nothing it cites — the
% state of a source tree whose template's own bibliography sits beside the one
% the source declares. With no --bibliography a build offers every .bib in the
% volume root's directory, this one with lamb.bib; citeproc renders only cited
% entries, so this file reaches no document. Its entry is deliberately
% citable-looking and deliberately uncited.
@misc{strayentry1999,
  author = {Stray, S.},
  title  = {A Work This Paper Does Not Cite},
  year   = {1999}
}
