\usepackage[nottoc]{tocbibind}
% Running heads in the heading's own case, since uppercasing breaks a link's
% label; a volume's title is often a paper's, so they are cut to the line.
% \truncate silences its trial setting of the uncut head with \hfuzz\vsize,
% which the output routine shrinks under top floats: the head sets \vsize to
% \maxdimen, inside its own group.
\usepackage[fit]{truncate}
\makeatletter
\def\ps@kbase{%
  \let\@oddfoot\@empty\let\@evenfoot\@empty
  \def\@oddhead{{\slshape\vsize\maxdimen\truncate{\dimexpr\textwidth-4em\relax}{\leftmark}}\hfil\thepage}%
  \let\@mkboth\markboth
  \def\chaptermark##1{\markboth{\ifnum\c@secnumdepth>\m@ne
    \if@mainmatter\@chapapp\ \thechapter.\ \fi\fi##1}{}}}
\makeatother
\pagestyle{kbase}
% \kbasetheorem{env}{Name}{Plural} declares a theorem-like environment. Every
% kind is upright, since the statements carry their own emphasis, and shares
% one counter numbered within the chapter; the alias counter is what lets
% \cref name the kind rather than the shared counter.
\usepackage{aliascnt}
\newcounter{kbasethm}
\counterwithin{kbasethm}{chapter}
\NewDocumentCommand\kbasetheorem{m m m}{%
  \theoremstyle{definition}%
  \newaliascnt{#1}{kbasethm}\newtheorem{#1}[#1]{#2}\aliascntresetthe{#1}%
  \crefname{#1}{#2}{#3}\Crefname{#1}{#2}{#3}}
\IfFileExists{xurl.sty}{\usepackage{xurl}}{} % add URL line breaks if available
