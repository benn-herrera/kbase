% The first numbered chapter opens the main matter: everything before it, the
% contents and the entry point's prose, is front matter. An unnumbered
% chapter sets no marks, so the last chapter's would head its pages: it is
% given its own title as both, less any \@mkboth inside it (the contents').
\makeatletter
\let\kbase@chapter\chapter
\newcommand\kbase@schapter[1]{%
  \kbase@chapter*{#1}{\let\@mkboth\@gobbletwo\markboth{#1}{#1}}}
\def\chapter{\@ifstar\kbase@schapter{\mainmatter\global\let\chapter\kbase@chapter\chapter}}
\makeatother
\AddToHook{env/thebibliography/before}{\backmatter}
