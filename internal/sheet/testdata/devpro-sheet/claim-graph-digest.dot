digraph "claim-graph-digest" {
  graph [rankdir=LR nodesep=0.5 ranksep=1.2 pad=0.3 fontname="Helvetica"]
  node [shape=plaintext fontname="Helvetica" fontsize=10]
  edge [fontname="Helvetica" fontsize=9 arrowsize=0.8]
  "v_0" [href="alpha/index.md" label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888" bgcolor="#fafafa"><tr><td align="left"><b>Alpha Volume</b></td></tr><tr><td align="left">6 nodes: 1 blocks, 1 equations, 2 prose, 1 analyses, 1 experiments</td></tr><tr><td align="left">0 unattached</td></tr><tr><td align="left">within: 3 supports · 2 lifts · 1 refutes · 1 cut</td></tr><tr><td align="left" href="alpha/claim-graph.svg"><font color="#1f6fb2">claim graph →</font></td></tr></table>>]
  "v_1" [href="beta/index.md" label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888" bgcolor="#fafafa"><tr><td align="left"><b>Beta &amp; &quot;Gamma&quot; &lt;draft&gt;</b></td></tr><tr><td align="left">1 node: 1 blocks</td></tr><tr><td align="left">0 unattached</td></tr><tr><td align="left" href="beta/claim-graph.svg"><font color="#1f6fb2">claim graph →</font></td></tr></table>>]
  "v_2" [href="entry-point.md" label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888" bgcolor="#fafafa"><tr><td align="left"><b>Sheet Fixture KB</b></td></tr><tr><td align="left">7 nodes: 1 blocks, 3 prose, 2 axioms, 1 works</td></tr><tr><td align="left">2 unattached</td></tr><tr><td align="left">within: 1 founds</td></tr></table>>]
  "v_0" -> "v_2" [label="1 supports" penwidth=1.2 color="#222222"]
  "v_0" -> "v_2" [label="1 cut" color="#c0392b" style=dotted penwidth=1.4 arrowhead=open constraint=false]
  "v_2" -> "v_0" [label="3 founds" penwidth=1.8 color="#222222"]
  "v_2" -> "v_1" [label="2 founds" penwidth=1.5 color="#222222"]
  legend [shape=plaintext label=<<table border="1" cellborder="0" cellspacing="2" cellpadding="3" color="#999999"><tr><td colspan="2" align="left"><b>legend</b></td></tr><tr><td><font color="#222222"><b>━━━▶</b></font></td><td align="left">supports — points from the premise to the claim</td></tr><tr><td><font color="#7d3c98"><b>╍╍╍◆</b></font></td><td align="left">founds — points from the cited work or the axiom to the claim</td></tr><tr><td><font color="#c0392b"><b>┈┈┈▷</b></font></td><td align="left">cut from supports: part of a circle</td></tr></table>>]
  "sheet-link" [shape=plaintext fontsize=10 fontcolor="#1f6fb2" label="← full claim graph" href="claim-graph.svg"]
  { rank=max; "sheet-link" }
}
